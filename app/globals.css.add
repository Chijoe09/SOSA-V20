/* Append to app/globals.css */
:root { --bg:#FFF8F0; --fg:#111111; --border:rgba(0,0,0,.12); }
.dark { --bg:#0A0A0A; --fg:#FFF8F0; --border:rgba(255,248,240,.18); }
body { background:var(--bg); color:var(--fg); }
/* Tailwind v3: darkMode:"class" | v4: @custom-variant dark (&:where(.dark, .dark *)); */
